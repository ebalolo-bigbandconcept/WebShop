# Lightweight test image - skip unnecessary prod optimizations
FROM python:3.12-slim

WORKDIR /app

# Install only build and runtime dependencies needed for tests
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    postgresql-client \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend/ .

# No CMD needed - will be overridden by docker compose exec or docker run
